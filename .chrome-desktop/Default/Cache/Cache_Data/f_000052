
@font-face {
  font-family: "TT Commons Pro";
  src: url("/fonts/TTCommonsPro-Rg.ttf") format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "TT Commons Pro";
  src: url("/fonts/TTCommonsPro-Md.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "TT Commons Pro";
  src: url("/fonts/TTCommonsPro-Bd.ttf") format("truetype");
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}
:root {
  --scholars-sky: #1ba6d1;
  --vital-green: #1bd183;
  --intellect-iris: #7f5cd3;
  --tech-charcoal: #333a3f;
  --cloud-grey: #f5f7fa;
  --deep-blue: #06141d;
  --ink-blue: #0a2430;
  --header-height: clamp(68px, 10svh, 92px);
}
* {
  box-sizing: border-box;
}
html,
body,
#__nuxt {
  min-height: 100%;
  overflow-x: hidden;
}
body {
  margin: 0;
  font-family: "TT Commons Pro", Arial, sans-serif;
  color: var(--deep-blue);
  background: #ffffff;
}
a {
  color: inherit;
  text-decoration: none;
}
.landing-page {
  min-height: 100vh;
  overflow-x: hidden;
  background: #ffffff;
}
.hero-section {
  position: relative;
  isolation: isolate;
  width: 100%;
  max-width: 100vw;
  min-height: auto;
  overflow: hidden;
  padding: 16px clamp(20px, 4vw, 48px) clamp(72px, 8vw, 112px);
  background:
    radial-gradient(125% 125% at 50% 100%, transparent 0%, #ffffff 72%),
    radial-gradient(circle at 50% 92%, rgba(27, 209, 131, 0.2), transparent 28%),
    linear-gradient(180deg, #ffffff 0%, #f7fbfc 100%);
}
.hero-section::before {
  position: absolute;
  inset: 0;
  z-index: -2;
  content: "";
  background: radial-gradient(72% 52% at 50% 118%, rgba(27, 166, 209, 0.18), transparent 66%);
  animation: surfaceReveal 1.1s ease-out both;
}
.hero-section::after {
  position: absolute;
  inset: auto 0 0 0;
  z-index: -1;
  height: 44%;
  content: "";
  background: linear-gradient(180deg, transparent 0%, #ffffff 70%);
}
.hero-rays {
  position: absolute;
  inset: 0;
  z-index: -3;
  pointer-events: none;
  opacity: 0.86;
}
.hero-rays span {
  position: absolute;
  top: -340px;
  left: -80px;
  width: 18rem;
  height: 70rem;
  border-radius: 999px;
  transform: rotate(-45deg);
  background: radial-gradient(50% 50% at 50% 50%, rgba(18, 35, 43, 0.08), rgba(18, 35, 43, 0.02) 74%, transparent 100%);
  animation: rayDrift 12s ease-in-out infinite alternate;
}
.hero-rays span:first-child {
  width: 35rem;
  background: radial-gradient(68.54% 68.72% at 55.02% 31.46%, rgba(18, 35, 43, 0.08), rgba(18, 35, 43, 0.02) 52%, transparent 82%);
}
.hero-rays span:nth-child(2) {
  left: 100px;
  width: 14rem;
  transform: translateY(-120px) rotate(-45deg);
}
.hero-rays span:nth-child(3) {
  left: 260px;
  width: 12rem;
  transform: translateY(-260px) rotate(-45deg);
}
.hero-radial {
  position: absolute;
  inset: auto 0 0;
  z-index: -2;
  height: 48%;
  background:
    radial-gradient(circle at 50% 100%, rgba(27, 209, 131, 0.2), transparent 36%),
    radial-gradient(circle at 62% 60%, rgba(27, 166, 209, 0.11), transparent 36%);
}
.site-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--header-height);
  min-width: 0;
  gap: 32px;
  animation: enterDown 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
}
.brand-link {
  display: inline-flex;
  align-items: center;
  width: clamp(168px, 18vw, 238px);
  min-width: 0;
}
.brand-logo {
  display: block;
  width: 100%;
  height: auto;
}
.center-nav {
  position: absolute;
  left: 50%;
  display: flex;
  gap: 30px;
  color: rgba(6, 20, 29, 0.6);
  font-size: 15px;
  font-weight: 500;
  transform: translateX(-50%);
}
.center-nav a:hover,
.center-nav a:focus-visible {
  color: var(--deep-blue);
}
.header-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  gap: clamp(12px, 2vw, 18px);
  font-size: clamp(15px, 1.2vw, 17px);
  font-weight: 500;
}
.nav-link,
.nav-button,
.primary-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  border-radius: 0;
  white-space: nowrap;
}
.nav-link {
  padding: 0 6px;
  color: rgba(6, 20, 29, 0.7);
}
.nav-link:hover,
.nav-link:focus-visible {
  color: var(--deep-blue);
}
.nav-button {
  min-width: 108px;
  padding: 0 22px;
  border: 1px solid rgba(6, 20, 29, 0.16);
  color: var(--deep-blue);
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(16px);
}
.nav-button:hover,
.nav-button:focus-visible {
  border-color: rgba(27, 166, 209, 0.44);
  background: #ffffff;
}
.hero-content {
  position: relative;
  z-index: 1;
  display: grid;
  justify-items: center;
  min-width: 0;
  min-height: 0;
  padding-top: clamp(64px, 10vw, 138px);
  text-align: center;
}
.hero-copy {
  width: min(900px, 100%);
  min-width: 0;
}
.hero-pill {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  min-height: 42px;
  padding: 6px 8px 6px 18px;
  border: 1px solid rgba(6, 20, 29, 0.1);
  color: rgba(6, 20, 29, 0.78);
  background: rgba(245, 247, 250, 0.74);
  box-shadow: 0 10px 32px rgba(6, 20, 29, 0.08);
  font-size: 15px;
  font-weight: 700;
  backdrop-filter: blur(18px);
  animation: enterUp 760ms cubic-bezier(0.16, 1, 0.3, 1) 130ms both;
}
.pill-divider {
  width: 1px;
  height: 18px;
  background: rgba(6, 20, 29, 0.14);
}
.pill-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  color: #ffffff;
  background: var(--deep-blue);
}
h1 {
  max-width: 920px;
  margin: clamp(28px, 5vw, 64px) auto 0;
  color: var(--deep-blue);
  font-size: clamp(54px, 7vw, 84px);
  font-weight: 700;
  line-height: 0.96;
  letter-spacing: 0;
  text-wrap: balance;
  overflow-wrap: break-word;
  animation: enterUp 820ms cubic-bezier(0.16, 1, 0.3, 1) 220ms both;
}
.hero-subheadline {
  max-width: 680px;
  margin: 24px auto 0;
  color: rgba(6, 20, 29, 0.62);
  font-size: clamp(18px, 1.55vw, 22px);
  font-weight: 400;
  line-height: 1.32;
  overflow-wrap: break-word;
  animation: enterUp 820ms cubic-bezier(0.16, 1, 0.3, 1) 330ms both;
}
.hero-actions {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: 36px;
  animation: ctaEnter 760ms cubic-bezier(0.16, 1, 0.3, 1) 440ms both;
}
.primary-cta {
  min-width: 180px;
  padding: 0 30px;
  border: 1px solid var(--deep-blue);
  color: #ffffff;
  background: var(--deep-blue);
  box-shadow: 0 18px 46px rgba(6, 20, 29, 0.18);
  font-size: 18px;
  font-weight: 700;
}
.primary-cta:hover,
.primary-cta:focus-visible {
  background: #102b38;
  border-color: #102b38;
}
.secondary-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  min-width: 150px;
  padding: 0 24px;
  border: 1px solid rgba(6, 20, 29, 0.1);
  color: rgba(6, 20, 29, 0.76);
  background: rgba(255, 255, 255, 0.76);
  font-size: 18px;
  font-weight: 700;
  white-space: nowrap;
}
.secondary-cta:hover,
.secondary-cta:focus-visible {
  color: var(--deep-blue);
  background: #f5f7fa;
}
.hero-preview {
  position: relative;
  width: min(1080px, 100%);
  margin-top: clamp(42px, 7vw, 86px);
  padding: 6px;
  border: 1px solid rgba(6, 20, 29, 0.1);
  background: #ffffff;
  box-shadow: 0 28px 80px rgba(6, 20, 29, 0.15);
  animation: previewEnter 920ms cubic-bezier(0.16, 1, 0.3, 1) 520ms both;
}
.hero-preview::before {
  position: absolute;
  inset: -1px;
  z-index: -1;
  content: "";
  background: linear-gradient(135deg, rgba(27, 166, 209, 0.34), rgba(27, 209, 131, 0.3));
  filter: blur(34px);
  opacity: 0.48;
}
.preview-frame {
  overflow: hidden;
  border: 1px solid rgba(6, 20, 29, 0.09);
  background: #eef5f7;
}
.preview-frame video {
  display: block;
  width: 100%;
  aspect-ratio: 15 / 8;
  -o-object-fit: cover;
     object-fit: cover;
}
.section-shell {
  width: min(1228px, calc(100% - clamp(40px, 10vw, 160px)));
  margin: 0 auto;
}
.social-proof-section {
  position: relative;
  overflow: hidden;
  padding: clamp(72px, 10vw, 124px) 0;
  background:
    radial-gradient(circle at 92% 12%, rgba(27, 209, 131, 0.12), transparent 31%),
    radial-gradient(circle at 8% 0%, rgba(27, 166, 209, 0.1), transparent 34%),
    #ffffff;
}
.social-proof-section::before,
.faq-section::before {
  position: absolute;
  inset: 0;
  pointer-events: none;
  content: "";
  background:
    linear-gradient(rgba(6, 20, 29, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(6, 20, 29, 0.045) 1px, transparent 1px);
  background-size: 64px 64px;
  -webkit-mask-image: linear-gradient(180deg, transparent, black 22%, black 72%, transparent);
          mask-image: linear-gradient(180deg, transparent, black 22%, black 72%, transparent);
}
.trusted-band {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(180px, 260px) 1fr;
  align-items: center;
  gap: 28px;
  padding-bottom: clamp(44px, 7vw, 72px);
}
.section-kicker {
  margin: 0;
  color: rgba(27, 209, 131, 0.92);
  font-size: 15px;
  font-weight: 700;
}
.trusted-logos {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  border: 1px solid rgba(6, 20, 29, 0.1);
  background: rgba(255, 255, 255, 0.72);
}
.trusted-logos span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72px;
  padding: 14px;
  border-right: 1px solid rgba(6, 20, 29, 0.1);
  color: rgba(6, 20, 29, 0.68);
  font-size: clamp(15px, 1.2vw, 18px);
  font-weight: 700;
  text-align: center;
}
.trusted-logos span:last-child {
  border-right: 0;
}
.proof-layout {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(360px, 1fr);
  align-items: center;
  gap: clamp(42px, 7vw, 88px);
}
.section-heading h2,
.final-cta h2 {
  max-width: 720px;
  margin: 14px 0 0;
  color: var(--deep-blue);
  font-size: clamp(36px, 4.8vw, 68px);
  font-weight: 700;
  line-height: 0.98;
  letter-spacing: 0;
  text-wrap: balance;
}
.section-heading p:not(.section-kicker),
.final-cta p:not(.section-kicker) {
  max-width: 610px;
  margin: 22px 0 0;
  color: rgba(6, 20, 29, 0.62);
  font-size: clamp(18px, 1.6vw, 22px);
  line-height: 1.36;
}
.demo-panel {
  border: 1px solid rgba(6, 20, 29, 0.1);
  background:
    linear-gradient(135deg, rgba(27, 166, 209, 0.13), rgba(27, 209, 131, 0.1)),
    #ffffff;
  box-shadow: 0 26px 70px rgba(6, 20, 29, 0.12);
}
.demo-panel video {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 10;
  -o-object-fit: cover;
     object-fit: cover;
  background: #050b0f;
}
.proof-stats {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: clamp(42px, 6vw, 70px);
  border: 1px solid rgba(6, 20, 29, 0.1);
}
.proof-stats div {
  min-height: 132px;
  padding: clamp(22px, 3vw, 34px);
  border-right: 1px solid rgba(6, 20, 29, 0.1);
  background: rgba(245, 247, 250, 0.72);
}
.proof-stats div:last-child {
  border-right: 0;
}
.proof-stats strong {
  display: block;
  color: var(--deep-blue);
  font-size: clamp(30px, 3.5vw, 48px);
  line-height: 1;
}
.proof-stats span {
  display: block;
  margin-top: 12px;
  color: rgba(6, 20, 29, 0.58);
  font-size: 17px;
}
.testimonial-grid,
.case-study-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-top: 16px;
}
.testimonial-card,
.case-card {
  min-height: 220px;
  padding: clamp(24px, 3vw, 34px);
  border: 1px solid rgba(6, 20, 29, 0.1);
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18px 48px rgba(6, 20, 29, 0.06);
}
.testimonial-card p {
  margin: 0;
  color: var(--deep-blue);
  font-size: clamp(21px, 2vw, 28px);
  font-weight: 500;
  line-height: 1.12;
}
.testimonial-card footer {
  display: grid;
  gap: 4px;
  margin-top: 34px;
}
.testimonial-card strong,
.case-card h3 {
  color: var(--deep-blue);
  font-size: 20px;
}
.testimonial-card span,
.case-card span,
.case-card p {
  color: rgba(6, 20, 29, 0.58);
  font-size: 16px;
  line-height: 1.38;
}
.case-card span {
  color: rgba(27, 209, 131, 0.86);
  font-weight: 700;
}
.case-card h3 {
  margin: 26px 0 0;
}
.case-card p {
  margin: 14px 0 0;
}
.faq-section {
  position: relative;
  overflow: hidden;
  padding: clamp(72px, 10vw, 124px) 0;
  background:
    radial-gradient(circle at 12% 20%, rgba(27, 166, 209, 0.1), transparent 28%),
    radial-gradient(circle at 84% 72%, rgba(27, 209, 131, 0.12), transparent 31%),
    #ffffff;
}
.faq-shell {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(280px, 0.72fr) minmax(420px, 1fr);
  gap: clamp(42px, 7vw, 88px);
}
.faq-heading {
  position: sticky;
  top: 32px;
  align-self: start;
}
.faq-list {
  display: grid;
  gap: 12px;
}
.faq-list details {
  border: 1px solid rgba(6, 20, 29, 0.1);
  background: rgba(245, 247, 250, 0.72);
}
.faq-list summary {
  cursor: pointer;
  padding: 22px 24px;
  color: var(--deep-blue);
  font-size: clamp(19px, 1.7vw, 24px);
  font-weight: 700;
  list-style: none;
}
.faq-list summary::-webkit-details-marker {
  display: none;
}
.faq-list summary::after {
  float: right;
  color: rgba(27, 209, 131, 0.9);
  content: "+";
}
.faq-list details[open] summary::after {
  content: "-";
}
.faq-list details p {
  margin: 0;
  padding: 0 24px 24px;
  color: rgba(6, 20, 29, 0.62);
  font-size: 18px;
  line-height: 1.42;
}
.final-cta {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: 32px;
  margin-top: clamp(48px, 7vw, 82px);
  padding: clamp(34px, 5vw, 58px);
  border: 1px solid rgba(6, 20, 29, 0.1);
  background:
    radial-gradient(circle at 86% 50%, rgba(27, 209, 131, 0.16), transparent 36%),
    linear-gradient(112deg, rgba(27, 166, 209, 0.12), rgba(245, 247, 250, 0.8));
  box-shadow: 0 24px 70px rgba(6, 20, 29, 0.08);
}
.final-cta h2 {
  max-width: 760px;
}
.final-cta-button {
  margin-top: 0;
}
.nav-link:focus-visible,
.nav-button:focus-visible,
.primary-cta:focus-visible,
.secondary-cta:focus-visible,
.center-nav a:focus-visible,
.brand-link:focus-visible {
  outline: 2px solid var(--deep-blue);
  outline-offset: 4px;
}
@media (max-width: 860px) {
:root {
    --header-height: clamp(64px, 9svh, 78px);
}
.hero-section {
    padding: 18px clamp(18px, 5vw, 36px) 58px;
    background:
      radial-gradient(125% 125% at 50% 100%, transparent 0%, #ffffff 72%),
      radial-gradient(circle at 50% 92%, rgba(27, 209, 131, 0.18), transparent 30%),
      linear-gradient(180deg, #ffffff 0%, #f7fbfc 100%);
}
.site-header {
    gap: 18px;
}
.brand-link {
    width: clamp(150px, 34vw, 198px);
}
.header-actions {
    gap: 10px;
}
.center-nav {
    display: none;
}
.nav-link,
  .nav-button {
    min-height: 42px;
}
.nav-button {
    min-width: 94px;
    padding: 0 16px;
}
.hero-content {
    padding-top: clamp(40px, 8svh, 76px);
}
h1 {
    max-width: 720px;
    font-size: clamp(44px, min(10vw, 9svh), 68px);
    line-height: 0.96;
}
.hero-subheadline {
    max-width: 540px;
    font-size: clamp(18px, 3.6vw, 21px);
}
.hero-grid {
    right: -34%;
    bottom: 8%;
    width: 86vw;
    opacity: 0.17;
}
.section-shell {
    width: min(100% - 36px, 720px);
}
.trusted-band,
  .proof-layout,
  .faq-shell,
  .final-cta {
    grid-template-columns: 1fr;
}
.trusted-band {
    gap: 18px;
}
.trusted-logos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}
.trusted-logos span {
    border-bottom: 1px solid rgba(6, 20, 29, 0.1);
}
.trusted-logos span:nth-child(2n) {
    border-right: 0;
}
.trusted-logos span:nth-last-child(-n + 1) {
    grid-column: 1 / -1;
    border-bottom: 0;
}
.proof-layout {
    gap: 34px;
}
.demo-panel {
    order: -1;
}
.proof-stats,
  .testimonial-grid,
  .case-study-grid {
    grid-template-columns: 1fr;
}
.proof-stats div {
    border-right: 0;
    border-bottom: 1px solid rgba(6, 20, 29, 0.1);
}
.proof-stats div:last-child {
    border-bottom: 0;
}
.testimonial-card,
  .case-card {
    min-height: auto;
}
.faq-heading {
    position: static;
}
.final-cta {
    align-items: start;
}
.final-cta-button {
    width: 100%;
}
}
@media (max-width: 560px) {
.hero-section {
    min-height: auto;
    padding: 14px 18px 56px;
}
.site-header {
    min-height: 68px;
}
.brand-link {
    width: 130px;
}
.header-actions {
    gap: 6px;
    font-size: 14px;
}
.nav-link {
    padding: 0 2px;
}
.nav-button {
    min-width: 76px;
    min-height: 38px;
    padding: 0 10px;
}
.hero-content {
    align-items: center;
    min-height: auto;
    padding-top: clamp(48px, 10svh, 72px);
}
h1 {
    max-width: 100%;
    font-size: clamp(38px, 10vw, 48px);
    line-height: 1;
}
.hero-subheadline {
    margin-top: 22px;
    font-size: 18px;
    line-height: 1.34;
}
.hero-actions {
    flex-direction: column;
    width: 100%;
}
.primary-cta,
  .secondary-cta {
    width: 100%;
    min-height: 50px;
    font-size: 17px;
}
.hero-pill {
    max-width: 100%;
    gap: 10px;
    font-size: 14px;
}
.hero-preview {
    margin-top: 44px;
}
.preview-frame video {
    aspect-ratio: 4 / 3;
}
.social-proof-section,
  .faq-section {
    padding: 64px 0;
}
.section-shell {
    width: calc(100% - 36px);
}
.trusted-logos {
    grid-template-columns: 1fr;
}
.trusted-logos span,
  .trusted-logos span:nth-child(2n) {
    min-height: 58px;
    border-right: 0;
    border-bottom: 1px solid rgba(6, 20, 29, 0.1);
}
.trusted-logos span:last-child {
    border-bottom: 0;
}
.section-heading h2,
  .final-cta h2 {
    font-size: clamp(34px, 10vw, 46px);
    line-height: 1;
}
.section-heading p:not(.section-kicker),
  .final-cta p:not(.section-kicker) {
    font-size: 18px;
}
.demo-panel video {
    aspect-ratio: 4 / 3;
}
.proof-stats div,
  .testimonial-card,
  .case-card,
  .final-cta {
    padding: 24px;
}
.testimonial-card p {
