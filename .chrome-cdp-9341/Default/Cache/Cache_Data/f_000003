
@font-face {
  font-family: "TT Commons Pro";
  src: url("/fonts/TTCommonsPro-Rg.ttf") format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "TT Commons Pro";
  src: url("/fonts/TTCommonsPro-Md.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "TT Commons Pro";
  src: url("/fonts/TTCommonsPro-Bd.ttf") format("truetype");
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}
:root {
  --scholars-sky: #1ba6d1;
  --vital-green: #1bd183;
  --intellect-iris: #7f5cd3;
  --tech-charcoal: #333a3f;
  --cloud-grey: #f5f7fa;
  --deep-blue: #06141d;
  --ink-blue: #0a2430;
  --header-height: clamp(68px, 10svh, 92px);
}
* {
  box-sizing: border-box;
}
html,
body,
#__nuxt {
  min-height: 100%;
}
body {
  margin: 0;
  font-family: "TT Commons Pro", Arial, sans-serif;
  color: var(--cloud-grey);
  background: var(--deep-blue);
}
a {
  color: inherit;
  text-decoration: none;
}
.landing-page {
  min-height: 100vh;
  overflow-x: hidden;
  background: var(--deep-blue);
}
.hero-section {
  position: relative;
  isolation: isolate;
  display: grid;
  grid-template-rows: auto 1fr;
  min-height: 100svh;
  overflow: hidden;
  padding: clamp(14px, 2.6svh, 24px) clamp(20px, 5vw, 80px) clamp(24px, 6svh, 72px);
  background:
    radial-gradient(circle at 72% 62%, rgba(27, 209, 131, 0.44), transparent 31%),
    radial-gradient(circle at 15% 18%, rgba(27, 166, 209, 0.36), transparent 34%),
    linear-gradient(126deg, #0a2633 0%, #09202a 42%, #0d422e 74%, #18a970 100%);
}
.hero-section::before {
  position: absolute;
  inset: 0;
  z-index: -3;
  content: "";
  background:
    linear-gradient(90deg, rgba(6, 20, 29, 0.68), rgba(6, 20, 29, 0.18) 50%, rgba(6, 20, 29, 0.38)),
    linear-gradient(180deg, rgba(3, 9, 14, 0.2), rgba(3, 9, 14, 0.7));
}
.hero-section::after {
  position: absolute;
  inset: auto 0 0;
  z-index: -2;
  height: 34%;
  content: "";
  background: linear-gradient(180deg, transparent, rgba(3, 12, 17, 0.76));
}
.hero-glow {
  position: absolute;
  z-index: -2;
  pointer-events: none;
  filter: blur(24px);
}
.hero-glow-primary {
  right: -12%;
  bottom: -20%;
  width: min(720px, 62vw);
  aspect-ratio: 1;
  background:
    radial-gradient(circle, rgba(27, 209, 131, 0.42), transparent 60%),
    radial-gradient(circle at 34% 38%, rgba(27, 166, 209, 0.26), transparent 48%);
}
.hero-glow-secondary {
  top: 12%;
  left: 46%;
  width: min(560px, 44vw);
  aspect-ratio: 1.2;
  background: radial-gradient(circle, rgba(127, 92, 211, 0.16), transparent 62%);
}
.hero-grid {
  position: absolute;
  right: clamp(-220px, -12vw, -90px);
  bottom: clamp(36px, 8vw, 96px);
  z-index: -1;
  width: min(760px, 62vw);
  aspect-ratio: 1;
  opacity: 0.23;
  background:
    linear-gradient(rgba(245, 247, 250, 0.12) 1px, transparent 1px),
    linear-gradient(90deg, rgba(245, 247, 250, 0.12) 1px, transparent 1px);
  background-size: 42px 42px;
  -webkit-mask-image: radial-gradient(circle, black 0%, transparent 68%);
          mask-image: radial-gradient(circle, black 0%, transparent 68%);
}
.site-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--header-height);
  min-width: 0;
  gap: 32px;
}
.brand-link {
  display: inline-flex;
  align-items: center;
  width: clamp(172px, min(20vw, 28svh), 248px);
  min-width: 0;
}
.brand-logo {
  display: block;
  width: 100%;
  height: auto;
  filter: brightness(0) invert(1);
}
.header-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  gap: clamp(12px, 2vw, 18px);
  font-size: clamp(15px, 1.2vw, 17px);
  font-weight: 500;
}
.nav-link,
.nav-button,
.primary-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  border-radius: 0;
  white-space: nowrap;
}
.nav-link {
  padding: 0 6px;
  color: rgba(245, 247, 250, 0.82);
}
.nav-link:hover,
.nav-link:focus-visible {
  color: #ffffff;
}
.nav-button {
  min-width: 108px;
  padding: 0 22px;
  border: 1px solid rgba(245, 247, 250, 0.28);
  color: #ffffff;
  background: rgba(245, 247, 250, 0.08);
  backdrop-filter: blur(16px);
}
.nav-button:hover,
.nav-button:focus-visible {
  border-color: rgba(27, 209, 131, 0.76);
  background: rgba(27, 209, 131, 0.14);
}
.hero-content {
  position: relative;
  z-index: 1;
  display: grid;
  align-items: center;
  min-width: 0;
  min-height: 0;
  padding-top: clamp(18px, 6svh, 72px);
}
.hero-copy {
  width: min(720px, 100%);
  min-width: 0;
}
.hero-kicker {
  margin: 0 0 20px;
  color: rgba(27, 209, 131, 0.9);
  font-size: clamp(16px, 1.3vw, 20px);
  font-weight: 700;
}
h1 {
  max-width: 760px;
  margin: 0;
  color: #ffffff;
  font-size: clamp(56px, min(8vw, 14svh), 112px);
  font-weight: 700;
  line-height: 0.9;
  letter-spacing: 0;
  text-wrap: balance;
}
.hero-subheadline {
  max-width: 648px;
  margin: 28px 0 0;
  color: rgba(245, 247, 250, 0.78);
  font-size: clamp(20px, 2vw, 28px);
  font-weight: 400;
  line-height: 1.28;
  overflow-wrap: break-word;
}
.primary-cta {
  min-width: 180px;
  margin-top: 42px;
  padding: 0 30px;
  border: 1px solid rgba(27, 209, 131, 0.86);
  color: #05120d;
  background: linear-gradient(90deg, var(--vital-green), #57e4ae);
  box-shadow: 0 22px 54px rgba(27, 209, 131, 0.25);
  font-size: 18px;
  font-weight: 700;
}
.primary-cta:hover,
.primary-cta:focus-visible {
  background: linear-gradient(90deg, #45e0a9, var(--scholars-sky));
  border-color: rgba(245, 247, 250, 0.48);
}
.nav-link:focus-visible,
.nav-button:focus-visible,
.primary-cta:focus-visible,
.brand-link:focus-visible {
  outline: 2px solid #ffffff;
  outline-offset: 4px;
}
@media (max-width: 860px) {
:root {
    --header-height: clamp(64px, 9svh, 78px);
}
.hero-section {
    padding: 18px clamp(18px, 5vw, 36px) 58px;
    background:
      radial-gradient(circle at 78% 72%, rgba(27, 209, 131, 0.46), transparent 34%),
      radial-gradient(circle at 12% 12%, rgba(27, 166, 209, 0.36), transparent 38%),
      linear-gradient(132deg, #082230 0%, #0a1b24 48%, #0d4c35 100%);
}
.site-header {
    gap: 18px;
}
.brand-link {
    width: clamp(150px, 34vw, 198px);
}
.header-actions {
    gap: 10px;
}
.nav-link,
  .nav-button {
    min-height: 42px;
}
.nav-button {
    min-width: 94px;
    padding: 0 16px;
}
.hero-content {
    padding-top: clamp(40px, 8svh, 76px);
}
h1 {
    max-width: 640px;
    font-size: clamp(50px, min(13vw, 12svh), 86px);
    line-height: 0.94;
}
.hero-subheadline {
    max-width: 580px;
    font-size: clamp(19px, 4vw, 24px);
}
.hero-grid {
    right: -34%;
    bottom: 8%;
    width: 86vw;
    opacity: 0.17;
}
}
@media (max-width: 560px) {
.hero-section {
    min-height: 100svh;
    padding: 14px 18px 44px;
}
.site-header {
    min-height: 68px;
}
.brand-link {
    width: 130px;
}
.header-actions {
    gap: 6px;
    font-size: 14px;
}
.nav-link {
    padding: 0 2px;
}
.nav-button {
    min-width: 76px;
    min-height: 38px;
    padding: 0 10px;
}
.hero-content {
    align-items: start;
    min-height: auto;
    padding-top: clamp(38px, 8svh, 64px);
}
.hero-kicker {
    margin-bottom: 16px;
    font-size: 15px;
}
h1 {
    max-width: 11ch;
    font-size: clamp(44px, 13vw, 56px);
    line-height: 0.96;
}
.hero-subheadline {
    margin-top: 24px;
    font-size: 19px;
    line-height: 1.34;
}
.primary-cta {
    width: 100%;
    min-height: 50px;
    margin-top: 34px;
    font-size: 17px;
}
.hero-glow-primary {
    right: -54%;
    bottom: -8%;
    width: 112vw;
}
.hero-glow-secondary {
    top: 20%;
    left: 8%;
    width: 78vw;
}
.hero-grid {
    right: -76%;
    bottom: 8%;
    width: 138vw;
    background-size: 34px 34px;
}
}

